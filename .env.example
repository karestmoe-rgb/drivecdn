# Biến môi trường Firebase Auth (không cần prefix VITE_, nạp động qua /api/firebase-config)
# Lấy các giá trị này trong Firebase Console -> Project settings -> Your apps -> SDK setup and configuration
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_APP_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_FIRESTORE_DATABASE_ID=""

# Email tài khoản Google Admin mặc định (tài khoản host Google Drive & duyệt quyền user)
ADMIN_EMAIL=""

# Tùy chọn cho Vercel Serverless: Lưu danh mục file & trạng thái cổng Cloud bền vững (miễn phí qua Upstash Redis trên Vercel Marketplace)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Tùy chọn kết nối Google Drive vĩnh viễn 24/7 (không cần chủ sở hữu đăng nhập lại mỗi giờ)
# Xem hướng dẫn copy mã Google Apps Script ngay trong tab "Quản trị Drive" của ứng dụng
DRIVE_BRIDGE_URL=""
DRIVE_BRIDGE_SECRET=""
# Tùy chọn ghim cố định 1 Folder ID trên Google Drive để mọi file luôn lưu vào đúng 1 thư mục kể cả khi redeploy
DRIVE_FOLDER_ID=""
