# ==============================================================================
# DriveCDN - Bien moi truong (Khong can prefix VITE_, nap dong qua /api/firebase-config)
# Chay `npm run setup` de tu dong sinh .env, firebase-applet-config.json va firestore.rules
# ==============================================================================

# 1. Firebase Web SDK (Bat buoc - lay tai Firebase Console -> Project settings -> Your apps)
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_APP_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
# Giu "(default)" neu dung Firestore mac dinh (hoac nhap Database ID rieng neu co)
FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# 2. Tai khoan Google Admin mac dinh (Bat buoc - dung email nay de host Google Drive & duyet User)
ADMIN_EMAIL=""

# 3. Upstash Redis KV (Khuyen nghi khi deploy len Vercel Serverless de luu danh muc & phien ben vung)
# Cai mien phi tu Vercel Marketplace -> Upstash Redis
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# 4. Google Drive Bridge 24/7 (Khuyen nghi - giup User upload 24/7 khong can Admin dang nhap lai moi gio)
# Dan ma trong preconfig/apps-script-bridge.gs len script.google.com va deploy Web App -> lay URL /exec
DRIVE_BRIDGE_URL=""
# Tuy chon: Chuoi bi mat khop voi Script Property BRIDGE_SECRET trong Apps Script
DRIVE_BRIDGE_SECRET=""
# Tuy chon: ID cua 1 thu muc Google Drive co dinh (vd: 1AbC...) de moi file luon luu vao dung 1 thu muc khi redeploy
DRIVE_FOLDER_ID=""

